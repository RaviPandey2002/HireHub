NODE_ENV=
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Database — MongoDB MUST run as a replica set (required by Prisma for transactions)
# Local example: mongodb://localhost:27017/Hirehub?replicaSet=rs0&directConnection=true
# Atlas example: mongodb+srv://<user>:<pass>@cluster.mongodb.net/hirehub
DATABASE_URL=

# GitHub OAuth
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
